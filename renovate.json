{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": ["dependencies"],
  "schedule": ["before 6am on monday"],
  "timezone": "Europe/Berlin",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Group dev tooling (mypy, pytest, ruff) into one PR",
      "matchDepNames": ["mypy", "pytest", "pytest-asyncio", "pytest-httpx", "ruff"],
      "groupName": "dev tooling"
    },
    {
      "description": "Group Gitea/GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "ci actions"
    }
  ]
}
